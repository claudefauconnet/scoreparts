{
  "name": "scoreparts",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www.js",
    "start:v2": "concurrently \"cross-env UI_VERSION=v2 node ./bin/www.js\" \"wait-on http://localhost:3006 && browser-sync start --config bs-config.cjs\"",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "~4.15.5"
  },
  "description": "score scrapper",
  "main": "app.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudefauconnet/scoreparts.git"
  },
  "keywords": [
    "score"
  ],
  "author": "claude fauconnet",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/claudefauconnet/scoreparts/issues"
  },
  "homepage": "https://github.com/claudefauconnet/scoreparts#readme",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "prettier": "^3.8.3",
    "wait-on": "^9.0.10"
  }
}
