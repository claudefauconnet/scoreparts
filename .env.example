# Chemin vers l'exécutable GraphicsMagick (laisser vide si gm est dans le PATH)
# Windows exemple : GM_EXE="C:\Users\toi\scoop\shims\gm.exe"
# Mac/Linux : GM_EXE=/usr/local/bin/gm
GM_EXE=

# Dossier bin de Ghostscript à ajouter au PATH (nécessaire sur Windows si gs absent du PATH)
# Windows exemple : GS_BIN=C:\Users\toi\tools\gs\bin
# Mac/Linux : GS_BIN=/usr/local/bin
GS_BIN=

# Interface utilisateur à servir : laisser vide (ou "v1") pour l'ancienne interface,
# mettre "v2" pour le nouveau design (dossier public-v2/)
# Commandes :
#   npm start          → ancienne interface (public/)
#   npm run start:v2   → nouveau design     (public-v2/)
UI_VERSION=
